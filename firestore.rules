rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: authenticated users can read public profile fields; only owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Listings collection: public read, owner mutation, rating updates
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.ownerId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']));

      // Subcollection for listing reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == reviewId;
      }
    }
  }
}
